# Cloudflare R2 Object Storage (CDN de Fotos)
R2_ACCOUNT_ID="tu_account_id"
R2_ACCESS_KEY_ID="tu_access_key_id"
R2_SECRET_ACCESS_KEY="tu_secret_access_key"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="fotos-cancha"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Credenciales de Producción de Mercado Pago
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Dominio público configurado en Coolify
FRONTEND_URL="https://alentar.com.ar"
BACKEND_PUBLIC_URL="https://alentar.com.ar"

# Clave para guardar precios y administrar en /admin
ADMIN_PASSWORD="alentar2026"

# Precios iniciales por defecto ($4.000 c/u y Promo 3 fotos x $10.000, editables en vivo desde /admin)
DEFAULT_PRICE_ARS=4000
DEFAULT_PROMO_QTY=3
DEFAULT_PROMO_PRICE_ARS=10000
